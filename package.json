{
  "name": "djconnect-vibecast-receiver",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "python3 scripts/import_vibecast.py --check && node scripts/verify_brand.mjs && node --test && python3 -m unittest discover -s tests -p \"*_test.py\"",
    "import:core": "python3 scripts/import_vibecast.py",
    "verify:core": "python3 scripts/import_vibecast.py --check",
    "build:bootstrap": "node scripts/build_bootstrap.mjs",
    "test:bootstrap": "node --test tests/bootstrap/*.test.mjs",
    "test:browser": "playwright test",
    "check:bootstrap": "npm run test:bootstrap && npm run build:bootstrap && npm run test:browser",
    "test:http-ui": "node qualification/http-ui/run.mjs",
    "build:bootstrap:qa": "node scripts/build_bootstrap_qa.mjs",
    "verify:bootstrap:qa": "node scripts/verify_bootstrap_qa.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "jsqr": "1.4.0",
    "wrangler": "4.151.0"
  },
  "dependencies": {
    "jose": "6.2.12",
    "qrcode-generator": "2.0.4"
  }
}
